# =============================================================================
# Local Development Stack — copy to .env and adjust as needed:
#   cp .env.example .env
#
# Ordering: GLOBAL settings first, then the DEFAULT RUN-SET toggles, shared
# VERSIONS and PROJECT PATHS, and finally one block PER SERVICE (most specific).
# =============================================================================


# #############################################################################
# 1. GLOBAL
# #############################################################################
TZ=Asia/Jakarta
NETWORK_NAME=lds-network
# Registry for base-image push (./lds.sh build-bases --push). Empty/local = local only.
REGISTRY=local


# #############################################################################
# 2. DEFAULT RUN-SET — per-service on/off toggles
# -----------------------------------------------------------------------------
# These decide which services come up when you run `lds up` / `lds start` with
# NO profile args. One independent switch per profile: set to `true` to include
# it in the default run-set, `false` to leave it off. Flip a single line to turn
# a group on/off — no comma-list editing.
#
#   proxy -> edge proxy + dns       php -> php-fpm + nginx (also pulls proxy + dns)
#   phpcacheadmin -> phpCacheAdmin UI    dbgate -> DBGate UI (independent toggles)
#
# NOTE: passing explicit profiles (`lds up kafka`) ignores ALL toggles and
# starts ONLY what you asked for. If every toggle is false, `lds up` (no args)
# falls back to `all`.
# #############################################################################
LDS_ENABLE_PROXY=true
LDS_ENABLE_PHP=true
LDS_ENABLE_MYSQL=true
LDS_ENABLE_MARIADB=false
LDS_ENABLE_MSSQL=false
LDS_ENABLE_ORACLE=false
LDS_ENABLE_POSTGRES=false
LDS_ENABLE_MONGO=false
LDS_ENABLE_REDIS=false
LDS_ENABLE_VALKEY=false
LDS_ENABLE_MEMCACHED=false
LDS_ENABLE_KAFKA=false
LDS_ENABLE_PHPCACHEADMIN=false
LDS_ENABLE_DBGATE=true
LDS_ENABLE_SOKETI=false
LDS_ENABLE_CENTRIFUGO=false
LDS_ENABLE_MQTT=false
LDS_ENABLE_DRAWDB=false
LDS_ENABLE_HOP=false
LDS_ENABLE_SUPERSET=false
LDS_ENABLE_SEMGREP=false
LDS_ENABLE_ZAP=false
LDS_ENABLE_TRIVY=false
LDS_ENABLE_CRG=false
LDS_ENABLE_VAULTWARDEN=false
LDS_ENABLE_MAIL=false
LDS_ENABLE_PENPOT=false
LDS_ENABLE_INSTATIC=false
LDS_ENABLE_ANALYTICS=false
LDS_ENABLE_TASKS=false
LDS_ENABLE_WIKI=false
LDS_ENABLE_OPENWA=false
LDS_ENABLE_HEADLESSX=false
LDS_ENABLE_PLAYWRIGHT=false
LDS_ENABLE_ERPNEXT=false
LDS_ENABLE_RUSTFS=false
LDS_ENABLE_DUCKDB=false
LDS_ENABLE_TRINO=false

# HTTPS overlay (opt-in feature, NOT a service profile). When true AND a
# proxy/php profile runs, `lds up` adds TLS to the edge proxy via
# docker-compose.https.yml and serves https://*.test. Mint the dev cert first:
#   lds certs        (uses mkcert if installed; else a self-signed openssl cert)
# Tunables (port / redirect behaviour) live in the Web block below.
LDS_ENABLE_HTTPS=false


# #############################################################################
# 3. BASE IMAGE VERSIONS  (built by ./lds.sh build-bases into lds/*)
# -----------------------------------------------------------------------------
# Defaults also live in scripts/build/build-bases.sh; export to override there.
# Bases now build FROM Docker Hardened Images (DHI). DHI_REGISTRY is the DHI
# namespace; language lds/*-dev bases use the `-dev` DHI flavor (shell + toolchain),
# while lds/nginx uses the hardened runtime flavor. DB services (block 5) also use
# runtime flavor. Each FROM tag's OS/flavor suffix (e.g. -debian13-dev,
# -alpine3.24-dev, -fpm-dev) lives in the matching base-images/*/Dockerfile;
# only the version number is set here.
# #############################################################################
DHI_REGISTRY=dhi.io
PHP_VERSION=8.4
GO_VERSION=1.26
RUST_VERSION=1.96
NODE_VERSION=26.3
JAVA_VERSION=25
PYTHON_VERSION=3.14
NGINX_VERSION=1.27


# #############################################################################
# 4. PROJECT PATHS  (where `lds new` scaffolds each technology)
# -----------------------------------------------------------------------------
# PHP_PROJECTS_PATH is special: it's ALSO the live mass-vhost mount for the php
# service — each <folder> under it is served at <folder>.test (docroot
# auto-detected: public/ > htdocs/ > root). Defaults to ./www (the example
# folder shipped with LDS); point it at your real projects dir, e.g.
# PHP_PROJECTS_PATH=D:/projects/PHP. The others are just scaffold destinations
# for `lds new <tech> <name>` — point each at wherever you keep that language's
# projects (e.g. ../../Go).
# #############################################################################
PHP_PROJECTS_PATH=./www
GO_PROJECTS_PATH=./projects/go
RUST_PROJECTS_PATH=./projects/rust
NODE_PROJECTS_PATH=./projects/node
PYTHON_PROJECTS_PATH=./projects/python
JAVA_PROJECTS_PATH=./projects/java
# Hop ETL projects — each folder = one Hop project (scaffold with lds new hop <name>).
# Registered automatically via hop-conf when the hop profile starts.
HOP_PROJECTS_PATH=./data/hop/projects
# Superset project folders — each subfolder = one dashboard project (YAML exports).
# Scaffold with: lds new superset <name>. Registered automatically on lds up superset.
SUPERSET_PROJECTS_PATH=./data/superset/projects
# only cron-shell (language cron jobs use their language path)
JOBS_PROJECTS_PATH=./projects/jobs


# #############################################################################
# 5. SERVICES  (per-service settings, most specific)
# #############################################################################

# --- Web: PHP + nginx + proxy + dns (profiles: php, proxy) ---
# Devilbox-style multi-project hosting. PHP_PROJECTS_PATH (the mass-vhost mount)
# lives in the PROJECT PATHS block above; the php service uses lds/php:${PHP_VERSION}.
# Runtime nginx images for stack UIs come from lds/nginx:${NGINX_VERSION}
# (defined in the base image block above).
# Resource limits for PHP-FPM + nginx
PROXY_MEM_LIMIT=256m
PHP_CPUS=2
PHP_MEM_LIMIT=512m

# Host port for the edge proxy (nginx-proxy). Keep 80 for clean URLs
# (http://myapp.test). Change only if port 80 is taken — then visit
# http://myapp.test:<port>. The proxy routes <name>.test to any container with
# VIRTUAL_HOST set (Go/Rust/Java/Node apps); PHP folders are the catch-all.
WEB_HOST_PORT=80
# HTTPS: host port for the proxy's TLS listener (used only when LDS_ENABLE_HTTPS=true).
WEB_HTTPS_PORT=443
# noredirect = serve both http and https; set to `redirect` to force http -> https.
HTTPS_METHOD=noredirect
# dnsmasq publishes DNS on this host port. Resolves *.test -> 127.0.0.1.
DNS_HOST_PORT=53
# NOTE: projects are served at the .test TLD. To change it, edit
# configs/nginx/default.conf and configs/dns/dnsmasq.conf together.

# --- MySQL (profile: mysql) ---
# DHI runtime flavor (dhi.io/mysql:${MYSQL_VERSION}); no -dev — DB images aren't modified.
MYSQL_VERSION=8.4-debian13
MYSQL_HOST_PORT=4400
MYSQL_SERVER_ID=1
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_MEM_LIMIT=1g
# Optional extra MySQL db/user init specs (comma-separated db:user:password).
# Used by `lds db init mysql` / `lds up mysql|all`. Example:
# MYSQL_INIT_SPECS=tool_a:tool_a:tool_a,tool_b:tool_b:tool_b
MYSQL_INIT_SPECS=

# --- MariaDB (profile: mariadb) ---
# Drop-in MySQL-compatible fork (DHI hardened image). utf8mb4 server defaults
# - also what ERPNext needs, so ERPNext reuses this shared instance.
MARIADB_VERSION=11.8-debian13
MARIADB_HOST_PORT=4406
MARIADB_ROOT_PASSWORD=root
MARIADB_DATABASE=app
MARIADB_USER=app
MARIADB_PASSWORD=app
MARIADB_MEM_LIMIT=1g

# --- Microsoft SQL Server 2022 (profile: mssql) ---
# SQL Server 2025 (Developer, free for dev/test; ACCEPT_EULA=Y is the license
# consent). Microsoft's tags are <year>-latest; 2022-latest is the previous
# major if you need it. The SA password MUST meet the SQL Server policy
# (8+ chars, 3 of 4: upper/lower/digit/symbol) or the server exits on boot;
# MSSQL_MEM_LIMIT must stay >= 2g (server needs it).
MSSQL_VERSION=2025-latest
MSSQL_HOST_PORT=4407
MSSQL_SA_PASSWORD=Lds-dev-2024!
MSSQL_MEM_LIMIT=2g

# --- Oracle Database Free 23ai (profile: oracle) ---
# Free developer license via the gvenzl/oracle-free mirror (NO Oracle account
# needed - the official container-registry.oracle.com image requires a login).
# ORACLE_PASSWORD sets SYS/SYSTEM (required); ORACLE_DATABASE creates a PDB of
# that name. First boot creates the DB (~1-2 min, several GB disk). EM Express
# web console: https://localhost:4409/em. Version pinned to the latest supported
# 23.x (gvenzl deprecates old specific tags fast); use 23-slim to float the major.
ORACLE_VERSION=23.26.2-slim
ORACLE_HOST_PORT=4408
ORACLE_EM_HOST_PORT=4409
ORACLE_PASSWORD=Oracle-dev-2024!
ORACLE_DATABASE=FREE
ORACLE_USER=app
ORACLE_MEM_LIMIT=2g

# --- PostgreSQL (profile: postgres) ---
POSTGRES_VERSION=18.4-alpine3.24
POSTGRES_HOST_PORT=4401
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_MEM_LIMIT=512m
# Optional extra Postgres db/user init specs (comma-separated db:user:password).
# Used by `lds db init postgres` / `lds up postgres|all`. Example for InsightTrack/Werkyn:
# POSTGRES_INIT_SPECS=lds_analytics:app:app,lds_tasks:app:app,lds_wiki:app:app,lds_openwa:app:app,lds_hive_metastore:app:app,lds_penpot:penpot:penpot
POSTGRES_INIT_SPECS=lds_analytics:app:app,lds_tasks:app:app,lds_wiki:app:app,lds_openwa:app:app,lds_hive_metastore:app:app,lds_penpot:app:app,lds_headlessx:app:app

# --- MongoDB (profile: mongo) ---
# DHI mongodb -dev flavor: runtime is mongod-only (no mongosh/shell); -dev adds
# the shell (keyfile gen) + mongosh (mongo-init users + healthcheck). Authenticated
# replica set (root + app users, like mysql/postgres); app connects as
# mongodb://app:app@mongo:27017/app?replicaSet=rs0.
MONGO_VERSION=8.3-debian13-dev
MONGO_HOST_PORT=4402
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=root
MONGO_USER=app
MONGO_PASSWORD=app
MONGO_DATABASE=app

# --- Redis (profile: redis) ---
REDIS_VERSION=8.8-alpine3.24
REDIS_HOST_PORT=4403

# --- Valkey (profile: valkey) ---
# Redis-compatible cache/data store with appendonly persistence.
VALKEY_VERSION=8.1-alpine
VALKEY_HOST_PORT=4405

# --- Memcached (profile: memcached) ---
MEMCACHED_VERSION=1.6-debian13
MEMCACHED_HOST_PORT=4404
MEMCACHED_MEMORY=64

# --- Kafka / KRaft (profile: kafka) ---
# DHI kafka (${DHI_REGISTRY}/kafka). Controller+broker config is in
# configs/kafka/{controller,broker}.properties (DHI ignores KAFKA_* env).
KAFKA_VERSION=4.3-debian13
# Must be a valid base64 22-char KRaft cluster id; shared by controller+broker.
# Generate a new one with:
#   docker run --rm dhi.io/kafka:4.3-debian13 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_HOST_PORT=4420
KAFKA_AUTO_CREATE_TOPICS=true
# Comma-separated topics to auto-create:  name:partitions:replication
KAFKA_TOPICS=demo.events:1:1,demo.audit:3:1

# Schema Registry — Apicurio Registry (Apache 2.0), replaces Confluent's
# cp-schema-registry. Confluent-compatible API exposed at /apis/ccompat/v7.
APICURIO_VERSION=2.6.13.Final
SCHEMA_REGISTRY_HOST_PORT=4421

# Kafka Connect powered by Debezium (MySQL + Postgres CDC connectors built in)
DEBEZIUM_VERSION=3.0
CONNECT_HOST_PORT=4423
CONNECT_GROUP_ID=connect-cluster
CONNECT_CONFIG_TOPIC=_connect_configs
CONNECT_OFFSET_TOPIC=_connect_offsets
CONNECT_STATUS_TOPIC=_connect_status

# Generic Kafka Connect (vanilla apache/kafka image — same runtime, NO bundled
# connectors). Drop plugin JARs into configs/kafka/connect-generic/plugins/.
# Config (group id, state topics, converters) lives in that folder's
# connect-distributed.properties.
CONNECT_GENERIC_HOST_PORT=4422

# Kafka UI (kafbat — maintained fork of provectus kafka-ui). Pinned to a release
# tag (not `latest`) for reproducible builds; bump as new versions ship.
KAFKA_UI_IMAGE=ghcr.io/kafbat/kafka-ui
KAFKA_UI_VERSION=v1.5.0
KAFKA_UI_HOST_PORT=4424

# --- Realtime / pub-sub brokers (profiles: soketi | centrifugo | mqtt) ---
# OFF by default (toggles above). Each is STATELESS (no data volume → no disk
# creep) and capped via mem/cpu below. Pick the broker whose CLIENT protocol
# matches your app — they are not interchangeable client-side.

# Soketi — Pusher-protocol WS server. Laravel Reverb/Echo + pusher-js compatible.
# In your Laravel app: BROADCAST_DRIVER=pusher, PUSHER_HOST=soketi, PUSHER_PORT=6001,
# PUSHER_APP_ID/KEY/SECRET = the values below. Echo connects with the same key.
SOKETI_VERSION=1.6-16-alpine
SOKETI_HOST_PORT=4440
SOKETI_HOST=ws.test
SOKETI_DEBUG=0
SOKETI_APP_ID=app-id
SOKETI_APP_KEY=app-key
SOKETI_APP_SECRET=app-secret
SOKETI_MEM_LIMIT=256m
SOKETI_CPUS=0.50

# Centrifugo — raw WebSocket channels + built-in admin UI (centrifugo.test / :4441).
# Clients use the Centrifuge JS SDK (not Echo). Runs in dev "insecure" mode so you
# can publish/subscribe without JWTs (flags set in docker-compose.yml).
CENTRIFUGO_VERSION=v5
CENTRIFUGO_HOST_PORT=4441
CENTRIFUGO_HOST=centrifugo.test
CENTRIFUGO_ALLOWED_ORIGINS=*
CENTRIFUGO_API_KEY=api-key
CENTRIFUGO_TOKEN_HMAC_SECRET_KEY=token-secret
CENTRIFUGO_ADMIN_PASSWORD=admin
CENTRIFUGO_ADMIN_SECRET=admin-secret
CENTRIFUGO_MEM_LIMIT=256m
CENTRIFUGO_CPUS=0.50

# MQTT — Eclipse Mosquitto broker + MQTTX Web client (profile: mqtt). Replaces
# EMQX: lightweight, anonymous, and the web UI (mqtt.test) needs NO login. Clients
# use an MQTT library (MQTT.js / Paho); browser clients use the WS port (4433).
# MQTT<->Kafka is done via the generic Kafka Connect worker + Stream Reactor MQTT
# connector (not the broker) — see docs/en/15-data-tools.md.
MOSQUITTO_VERSION=2.0.22
# native MQTT (in-network: mosquitto:1883)
MQTT_HOST_PORT=4442
# MQTT over WebSocket (point MQTTX here: localhost:4443)
MQTT_WS_HOST_PORT=4443
MOSQUITTO_MEM_LIMIT=128m
# MQTTX Web — no-login browser MQTT client.
MQTTX_VERSION=v1.13.0
MQTT_HOST=mqtt.test
MQTTX_HOST_PORT=4444
MQTTX_MEM_LIMIT=128m

# --- Admin tools (profiles: phpcacheadmin | dbgate) ---
# Independent web UIs, each on its own profile. Reachable at <host>.test (via
# proxy) or http://localhost:<port>.
# phpCacheAdmin (Redis + Memcached); DBGate (MySQL + Postgres, pre-connected).
PHPCACHEADMIN_VERSION=2.5.2
CACHE_ADMIN_HOST=cache.test
CACHE_ADMIN_HOST_PORT=4500
DBGATE_VERSION=7.2.0
DBGATE_MEM_LIMIT=384m
DB_ADMIN_HOST=db.test
DB_ADMIN_HOST_PORT=4501

# --- DrawDB (profile: drawdb) — browser DB schema designer / ER diagrams ---
# Upstream image (not on DHI); static SPA, diagrams persist in your browser.
DRAWDB_IMAGE=ghcr.io/drawdb-io/drawdb
DRAWDB_VERSION=v1.7.0
DRAWDB_HOST=drawdb.test
DRAWDB_HOST_PORT=4502
DRAWDB_MEM_LIMIT=128m

# --- Data warehouse tooling (profiles: hop | superset) ---
# Apache Hop Web = browser ETL/DW pipeline designer (upstream image). No login;
# served under /ui (the app auto-redirects / -> /ui). Connect it to postgres/mysql.
# NOTE: use apache/hop-web (the designer), NOT apache/hop (headless hop-server).
HOP_IMAGE=apache/hop-web
HOP_VERSION=2.18.1
# MySQL Connector/J jar (not bundled — GPL). Download into assets/jdbc/.
HOP_MYSQL_DRIVER=mysql-connector-j-9.7.0.jar
# MariaDB JDBC jar (LGPL — not bundled).
HOP_MARIADB_DRIVER=mariadb-java-client-3.5.9.jar
# Oracle JDBC jar (Oracle Free Use Terms — not bundled).
HOP_ORACLE_DRIVER=ojdbc11-23.26.2.0.0.jar
# MSSQL JDBC jar (Microsoft EULA — not bundled).
HOP_MSSQL_DRIVER=mssql-jdbc-12.8.1.jre11.jar
# PostgreSQL JDBC jar (override bundled version if needed).
HOP_POSTGRESQL_DRIVER=postgresql-42.7.4.jar
HOP_TRINO_DRIVER=trino-jdbc-483.jar
HOP_HOST=hop.test
HOP_HOST_PORT=4503
HOP_MEM_LIMIT=1g
# Where Hop projects live inside the container (mounted from HOP_PROJECTS_PATH).
# hop-conf registers each subfolder as a project in hop-config.json on up.
HOP_PROJECTS_CONTAINER_PATH=/home/hop

# Apache Superset = BI dashboards & reporting. Docker Hardened Image
# (${DHI_REGISTRY}/superset), non-dev runtime variant (nonroot, no shell) — the
# self-init runs via the image's venv python. Self-inits on first start; admin
# login below; metadata in a local SQLite volume. Add the stack DBs as data sources.
SUPERSET_VERSION=6.1-debian13
SUPERSET_HOST=superset.test
SUPERSET_HOST_PORT=4504
SUPERSET_ADMIN=admin
SUPERSET_PASSWORD=admin
SUPERSET_SECRET_KEY=lds-dev-secret-change-me
# Superset internal data (SQLite DB, config). Bind-mounted to /app/superset_home.
SUPERSET_HOME=./data/superset
# Where Superset projects live inside the container (mounted from SUPERSET_PROJECTS_PATH).
SUPERSET_PROJECTS_CONTAINER_PATH=/app/superset_projects
SUPERSET_MEM_LIMIT=2g

# --- Semgrep (profile: semgrep) — SAST scanner + lightweight SARIF viewer ---
# `lds tools semgrep [path]` runs the scan (upstream semgrep/semgrep image) and
# writes data/semgrep/reports/report.sarif; the `semgrep` profile serves a
# self-contained viewer at semgrep.test. No DB.
# SEMGREP_RULES: ruleset to scan with. Use a registry pack (p/default, p/php,
# p/security-audit, p/ci), a rules URL, or a local YAML — these run with telemetry
# OFF. `auto` is also valid but REQUIRES metrics on (it phones home to pick rules),
# and that end-of-run upload can hang on slow/offline links.
SEMGREP_IMAGE=semgrep/semgrep
SEMGREP_VERSION=1.167.0
SEMGREP_RULES=p/default
SEMGREP_HOST=semgrep.test
SEMGREP_HOST_PORT=4505
SEMGREP_MEM_LIMIT=64m

# --- OWASP ZAP (profile: zap) — DAST scanner for running web apps ---
# Full desktop UI in the browser (WebSwing) at zap.test: the UI is served on
# :4510 and ZAP's proxy/API on :4512. `stable` is a rolling tag; pin a specific
# version (e.g. 2.17.0) for reproducibility. Resolves *.test apps INSIDE the
# network (via the dns container's in-network view), so you can scan
# http://myapp.test straight from the UI. Persistent runtime/session files are
# bind-mounted into data/zap/.
ZAP_VERSION=stable
ZAP_HOST=zap.test
ZAP_HOST_PORT=4510
ZAP_PROXY_HOST_PORT=4512
ZAP_MEM_LIMIT=2g

# --- Trivy (profile: trivy) — CVE scanner for containers, filesystems, deps ---
# `lds tools trivy [path]` (fs scan) or `lds tools trivy image <image>` (image
# scan) writes data/trivy/reports/report.html; the `trivy` profile serves it
# at trivy.test (like the semgrep viewer). The vulnerability DB is cached in
# data/trivy/cache so it downloads once, not per scan.
TRIVY_IMAGE=aquasec/trivy
TRIVY_VERSION=0.58.1
TRIVY_HOST=trivy.test
TRIVY_HOST_PORT=4511
TRIVY_MEM_LIMIT=64m
# CLI scan tuning for large repos/vendor trees. Defaults in wrappers are:
# TRIVY_SCANNERS=vuln (faster; CVE-focused) and TRIVY_TIMEOUT=30m.
# Set TRIVY_SCANNERS=vuln,secret if you also want secret scanning.
TRIVY_SCANNERS=vuln
TRIVY_TIMEOUT=30m

# --- code-review-graph (profile: crg) - AI code-intelligence graph ---
# `lds tools crg <path> [name]` builds a Tree-sitter graph of a repo (written
# to .code-review-graph/ inside it - gitignored) and exports the interactive D3
# HTML to data/crg/reports/<name>/; the `crg` profile serves those at crg.test
# (like the semgrep/trivy viewers). Local-first - nothing leaves your machine.
# The scanner image is built from configs/crg (pip install of this version).
CRG_VERSION=2.3.7
CRG_HOST=crg.test
CRG_HOST_PORT=4530
CRG_MEM_LIMIT=64m

# --- Vaultwarden (profile: vaultwarden) — Bitwarden-compatible password manager ---
# Single lightweight container; sqlite data persisted in a named volume.
VAULTWARDEN_VERSION=1.34.3
VAULTWARDEN_HOST=vaultwarden.test
VAULTWARDEN_HOST_PORT=4506
VAULTWARDEN_DOMAIN=http://vaultwarden.test
VAULTWARDEN_SIGNUPS_ALLOWED=false
# Admin UI token (change if shared beyond local usage).
VAULTWARDEN_ADMIN_TOKEN=vaultwarden-dev-admin-token-change-me
VAULTWARDEN_MEM_LIMIT=128m
VAULTWARDEN_CPUS=0.25

# --- Mailpit (profile: mail) — local SMTP sink + web inbox ---
# Mailchimp-like local development workflow: send test mail safely without
# delivering to real recipients.
MAILPIT_VERSION=v1.27
MAIL_HOST=mail.test
MAIL_HOST_PORT=4513
MAIL_SMTP_HOST_PORT=4514
MAIL_MEM_LIMIT=256m

# --- Penpot (profile: penpot) — collaborative design tool ---
# Requires postgres + valkey (included automatically via profile membership).
PENPOT_VERSION=2.17.0
PENPOT_HOST=penpot.test
PENPOT_HOST_PORT=4518
# up.sh/up.bat auto-switches this to https:// when LDS_ENABLE_HTTPS is active
# with proxy/php/all selected, and back to http:// otherwise.
PENPOT_PUBLIC_URI=http://penpot.test
PENPOT_FLAGS=enable-registration enable-login-with-password disable-email-verification
PENPOT_SECRET_KEY=penpot-dev-secret-key-change-me-please
# Optional explicit URI override (default uses postgres + PENPOT_POSTGRES_DB).
PENPOT_DATABASE_URI=postgresql://postgres/lds_penpot
# Dedicated Penpot DB/user on shared LDS PostgreSQL.
PENPOT_POSTGRES_DB=lds_penpot
PENPOT_POSTGRES_USER=app
PENPOT_POSTGRES_PASSWORD=app
PENPOT_OBJECTS_STORAGE_BACKEND=fs
PENPOT_OBJECTS_STORAGE_FS_DIRECTORY=/opt/data/assets
PENPOT_TELEMETRY_ENABLED=false
# Internal service-to-service URI stays http on the Docker network.
PENPOT_INTERNAL_URI=http://penpot-frontend:8080
PENPOT_FRONTEND_MEM_LIMIT=512m
PENPOT_BACKEND_MEM_LIMIT=1g
PENPOT_EXPORTER_MEM_LIMIT=512m

# --- Instatic (profile: instatic) - self-hosted visual CMS / website builder ---
# Webflow/Framer/WordPress alternative (MIT, official single-image Bun server).
# Canvas editor + content engine + publisher that emits clean static HTML/CSS.
# Admin UI at instatic.test/admin; SQLite + uploads persist in ./data/instatic.
# Optionally switch INSTATIC_DATABASE_URL to the shared Postgres. Pre-1.0 (0.0.x).
INSTATIC_VERSION=0.0.14
INSTATIC_HOST=instatic.test
INSTATIC_HOST_PORT=4528
INSTATIC_DATABASE_URL=sqlite:/app/data/cms.db
INSTATIC_TRUSTED_PROXY_CIDRS=0.0.0.0/0
INSTATIC_SECRET_KEY=instatic-dev-secret-key-change-me
# CSRF origin allowlist (comma-separated). Defaults cover https+http of
# INSTATIC_HOST and the direct localhost port; set only if you need more.
INSTATIC_PUBLIC_ORIGIN=
INSTATIC_MEM_LIMIT=512m

# --- LDS Analytics (profile: analytics) — Nuxt/Vue reactive web analytics ---
# Backend: Hono + Drizzle + PostgreSQL + DuckDB. Frontend: Nuxt 3 + Vue reactivity.
ANALYTICS_HOST=analytics.test
ANALYTICS_HOST_PORT=4521
ANALYTICS_API_HOST_PORT=4520
ANALYTICS_POSTGRES_DB=lds_analytics
ANALYTICS_POSTGRES_USER=app
ANALYTICS_POSTGRES_PASSWORD=app
ANALYTICS_CORS_ORIGIN=http://localhost:4173,http://analytics.test
ANALYTICS_API_MEM_LIMIT=384m
ANALYTICS_UI_MEM_LIMIT=256m

# --- LDS Tasks (profile: tasks) — Angular project management + integrated wiki ---
# Backend: Hono + Drizzle + PostgreSQL. Frontend: Angular 19 + CDK drag-drop.
TASKS_HOST=tasks.test
TASKS_HOST_PORT=4523
TASKS_API_HOST_PORT=4522
TASKS_POSTGRES_DB=lds_tasks
TASKS_POSTGRES_USER=app
TASKS_POSTGRES_PASSWORD=app
TASKS_CORS_ORIGIN=http://localhost:4174,http://tasks.test
TASKS_API_MEM_LIMIT=384m
TASKS_UI_MEM_LIMIT=384m

# --- LDS Wiki (profile: wiki) — Next.js standalone documentation hub ---
# Backend: Hono + Drizzle + PostgreSQL. Frontend: Next.js 15 + App Router.
WIKI_HOST=wiki.test
WIKI_HOST_PORT=4525
WIKI_API_HOST_PORT=4524
WIKI_POSTGRES_DB=lds_wiki
WIKI_POSTGRES_USER=app
WIKI_POSTGRES_PASSWORD=app
WIKI_CORS_ORIGIN=http://localhost:4175,http://wiki.test
WIKI_UI_MEM_LIMIT=256m
WIKI_API_MEM_LIMIT=256m

# --- OpenWA (profile: openwa) — WhatsApp API gateway (rmyndharis fork) ---
# Full-stack WhatsApp API gateway with NestJS backend + React dashboard.
# Integrates with LDS Postgres + Redis for persistence and caching.
# Image published to ghcr.io/rmyndharis/openwa.
OPENWA_IMAGE=ghcr.io/rmyndharis/openwa
OPENWA_VERSION=latest
OPENWA_HOST=openwa.test
OPENWA_HOST_PORT=4507
OPENWA_MASTER_KEY=openwa-dev-master-key-change-me
OPENWA_POSTGRES_DB=lds_openwa
OPENWA_POSTGRES_USER=app
OPENWA_POSTGRES_PASSWORD=app
OPENWA_NODE_ENV=production
OPENWA_LOG_LEVEL=info
OPENWA_REDIS_ENABLED=false
OPENWA_MEM_LIMIT=512m

# --- HeadlessX (profile: headlessx) — undetected self-hosted browser automation ---
# Web dashboard (Next.js) + Express API/worker + remote MCP endpoint, built from a
# local git checkout of https://github.com/saifyxpro/HeadlessX (HEADLESSX_REPO_PATH,
# auto-cloned by `lds headlessx init` / `lds up headlessx`). Reuses LDS Postgres
# (lds_headlessx DB, auto-created via POSTGRES_INIT_SPECS) + Redis (logical DB 4).
HEADLESSX_REPO_URL=https://github.com/saifyxpro/HeadlessX
HEADLESSX_REPO_REF=main
HEADLESSX_REPO_PATH=./data/headlessx
HEADLESSX_HOST=headlessx.test
HEADLESSX_API_HOST=headlessx-api.test
HEADLESSX_WEB_HOST_PORT=4515
HEADLESSX_API_HOST_PORT=4516
HEADLESSX_HTML_TO_MD_HOST_PORT=4517
HEADLESSX_YT_ENGINE_HOST_PORT=4519
HEADLESSX_POSTGRES_DB=lds_headlessx
HEADLESSX_POSTGRES_USER=app
HEADLESSX_POSTGRES_PASSWORD=app
HEADLESSX_REDIS_DB=4
HEADLESSX_DASHBOARD_INTERNAL_API_KEY=headlessx-dev-internal-key-change-me
HEADLESSX_CREDENTIAL_ENCRYPTION_KEY=headlessx-dev-encryption-key-change-me
HEADLESSX_FRONTEND_URL=http://headlessx.test
HEADLESSX_HTML_TO_MARKDOWN_TIMEOUT_MS=60000
HEADLESSX_YT_ENGINE_TIMEOUT_MS=45000
HEADLESSX_YT_ENGINE_JOB_TTL_HOURS=12
HEADLESSX_BULLMQ_QUEUE_NAME=headlessx-jobs
HEADLESSX_QUEUE_WORKER_CONCURRENCY=2
HEADLESSX_QUEUE_JOB_ATTEMPTS=3
HEADLESSX_QUEUE_JOB_BACKOFF_MS=5000
HEADLESSX_QUEUE_STREAM_POLL_MS=1000
HEADLESSX_API_MEM_LIMIT=1g
HEADLESSX_WORKER_MEM_LIMIT=1g
HEADLESSX_WEB_MEM_LIMIT=512m
HEADLESSX_HTML_TO_MD_MEM_LIMIT=256m
HEADLESSX_YT_ENGINE_MEM_LIMIT=512m

# --- Playwright (profile: playwright) — End-To-End testing runner + report viewer ---
# Official Playwright image (browsers pre-installed), joined to the in-network DNS
# so browsers can test http://<app>.test services. Projects live in
# data/playwright/projects (scaffold: `lds playwright init <name> [url]`); HTML
# reports land in data/playwright/reports and are served at playwright.test.
# Keep PLAYWRIGHT_VERSION (image tag) in sync with @playwright/test in the projects.
PLAYWRIGHT_VERSION=v1.62.1-noble
PLAYWRIGHT_PROJECTS_PATH=./data/playwright/projects
PLAYWRIGHT_REPORT_HOST=playwright.test
PLAYWRIGHT_REPORT_HOST_PORT=4526
PLAYWRIGHT_UI_HOST_PORT=4527
PLAYWRIGHT_MEM_LIMIT=1g
PLAYWRIGHT_REPORT_MEM_LIMIT=64m

# --- ERPNext (profile: erpnext) - full ERP suite on the Frappe framework ---
# Accounting, CRM, HR, Inventory, Manufacturing, eCommerce. Uses the SHARED
# lds-postgres (default; ERPNext's Postgres port landed upstream in 2026) +
# SHARED lds-redis (logical DBs 5/6 - tune to avoid colliding with other
# tenants), plus backend/frontend/worker/scheduler/socketio and two one-shot
# bootstrap services that create the site on first boot (several minutes -
# migrations). Web UI at erpnext.test; login Administrator /
# ERPNEXT_ADMIN_PASSWORD. HEAVY: ~3-6 GB RAM + multi-GB image pulls.
# DB backend: postgres (default) or mariadb. For mariadb, also enable the
# shared mariadb profile (LDS_ENABLE_MARIADB=true or lds up mariadb erpnext).
ERPNEXT_DB_TYPE=postgres
ERPNEXT_VERSION=16.31.1
ERPNEXT_HOST=erpnext.test
ERPNEXT_HOST_PORT=4529
# Site name used inside the stack (URL is always ERPNEXT_HOST).
ERPNEXT_SITE=frontend
# Database name created in the shared postgres/mariadb (was random by default).
ERPNEXT_DB_NAME=lds_erpnext
ERPNEXT_ADMIN_PASSWORD=admin
# Logical Redis DBs on the shared lds-redis.
ERPNEXT_REDIS_CACHE_DB=5
ERPNEXT_REDIS_QUEUE_DB=6
ERPNEXT_GUNICORN_THREADS=4
ERPNEXT_GUNICORN_WORKERS=2
ERPNEXT_GUNICORN_TIMEOUT=120
ERPNEXT_CONFIGURATOR_MEM_LIMIT=512m
ERPNEXT_CREATE_SITE_MEM_LIMIT=2g
ERPNEXT_BACKEND_MEM_LIMIT=2g
ERPNEXT_FRONTEND_MEM_LIMIT=256m
ERPNEXT_WORKER_MEM_LIMIT=1g
ERPNEXT_WORKER_LONG_MEM_LIMIT=1g
ERPNEXT_SCHEDULER_MEM_LIMIT=512m
ERPNEXT_WEBSOCKET_MEM_LIMIT=256m

# --- RustFS (profile: rustfs) — S3-compatible object storage ---
# High-performance S3 storage with web admin console.
# API port (4508) for S3 clients; Console port (4509) for the web admin UI.
RUSTFS_IMAGE=rustfs/rustfs
RUSTFS_VERSION=latest
RUSTFS_HOST=rustfs.test
RUSTFS_API_PORT=4508
RUSTFS_CONSOLE_PORT=4509
RUSTFS_ACCESS_KEY=lds-rustfs-admin
RUSTFS_SECRET_KEY=lds-rustfs-secret-change-me
RUSTFS_BUCKET=lds-data
RUSTFS_MEM_LIMIT=256m

# --- DuckDB (profile: duckdb) — embedded analytical database ---
# Official DuckDB CLI image with the httpserver extension for REST API access.
# Use via DBGate (http://duckdb.test) or docker exec:
#   docker exec -it lds-duckdb duckdb -c "SELECT * FROM read_parquet('/data/sales.parquet')"
DUCKDB_VERSION=1.2.0
DUCKDB_MEM_LIMIT=256m

# --- Trino (profile: trino) — distributed SQL query engine ---
# Full ANSI SQL engine with Hive connector for Parquet files. Federated queries
# across MySQL, Postgres, Kafka, and more. Built-in web UI at localhost:4451/ui.
# Auto-starts the Hive Metastore (apache/hive:4.0.0 official image) for Parquet
# table schema management, backed by LDS Postgres (lds_hive_metastore database).
TRINO_VERSION=latest
TRINO_HOST_PORT=4451
TRINO_MEM_LIMIT=2g

# Hive Metastore (auto-started with Trino). Stores Parquet table schemas in LDS
# Postgres. The lds_hive_metastore DB/user is created by hive-metastore-init
# (auto-run by `lds up` for trino/all) via POSTGRES_INIT_SPECS. Requires the
# PostgreSQL JDBC driver — download once:
#   curl -fsSL -o assets/jdbc/postgresql-42.7.4.jar \
#     https://repo1.maven.org/maven2/org/postgresql/postgresql/42.7.4/postgresql-42.7.4.jar
HIVE_METASTORE_POSTGRES_DB=lds_hive_metastore
HIVE_METASTORE_POSTGRES_USER=app
HIVE_METASTORE_POSTGRES_PASSWORD=app
HIVE_METASTORE_POSTGRES_DRIVER=postgresql-42.7.4.jar
HIVE_METASTORE_MEM_LIMIT=512m
