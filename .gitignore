
# Local env at root level — never commit secrets
/.env

# Project folders (mount point for your code) — keep only the sample
/www/*
!/www/example
/www/example/*
!/www/example/public
/www/example/public/*
!/www/example/public/index.php
data/*/*
data/headlessx/

# OS / editor noise
.DS_Store
Thumbs.db
*.log
nul
**/node_modules/

# LDS app generated files
configs/analytics/ui/.nuxt/
configs/analytics/ui/dist/
configs/tasks/ui/dist/
configs/wiki/ui/.next/
configs/wiki/ui/out/
configs/*/ui/package-lock.json
configs/*/api/package-lock.json

# AI CLI / inference local databases
*.db
*.db-*

# Freebuff Desktop local state — tool-managed, per-machine (only the shared
# skill preload list is committed; its own .gitignore says not to commit the
# project id)
/.freebuff/*
!/.freebuff/settings.json
