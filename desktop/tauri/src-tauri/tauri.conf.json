{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LDS Desktop",
  "version": "0.1.0",
  "identifier": "com.localdevstack.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LDS Desktop",
        "width": 1080,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "DeveloperTool",
    "shortDescription": "Local Dev Stack desktop companion",
    "longDescription": "Tray + panel companion for the local-dev-stack Docker Compose environment: start/stop profiles, container status, tool links and logs.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
